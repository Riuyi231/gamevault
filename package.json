{
  "name": "gamevault",
  "productName": "GameVault",
  "version": "1.10.1",
  "description": "GameVault - Modern multi-platform game launcher",
  "author": "Riuyi231",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "release": "electron-builder --win --publish always",
    "dist": "electron-builder --win --publish never",
    "fetch-emulators": "powershell -ExecutionPolicy Bypass -File scripts/init-emulators.ps1"
  },
  "dependencies": {
    "chokidar": "^4.0.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.gamevault.launcher",
    "productName": "GameVault",
    "publish": [
      {
        "provider": "github",
        "owner": "Riuyi231",
        "repo": "gamevault"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GameVault",
      "artifactName": "GameVault-Setup-${version}.${ext}"
    },
    "files": [
      "src/**/*",
      "assets/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/emulators",
        "to": "emulators"
      }
    ],
    "directories": {
      "output": "dist"
    }
  }
}
