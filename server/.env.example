# Claves IGDB/Twitch (obligatorio: sin ellas el proxy no puede servir IGDB)
IGDB_CLIENT_ID=tu_client_id
IGDB_CLIENT_SECRET=tu_client_secret

# Opcionales: portadas de TheGamesDB y SteamGridDB
#TGDB_API_KEY=
#SGDB_API_KEY=

# Puerto del servidor
PORT=8080

# Cuantas peticiones a IGDB se lanzan como maximo por segundo (IGDB limita ~4)
IGDB_MAX_PER_SEC=4

# Maximo de peticiones por IP por minuto
IP_MAX_PER_MIN=120

# Opcional: restringir origenes. Vacio = aceptar cualquier origen ("*")
#ALLOWED_ORIGINS=https://tudominio.com